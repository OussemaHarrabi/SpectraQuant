# Normalize line endings; repository stores LF.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.sh   text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary / large artifacts are never diffed
*.pt        binary
*.pth       binary
*.ckpt      binary
*.safetensors binary
*.bin       binary
*.gguf      binary
*.onnx      binary
*.png       binary
*.jpg       binary
*.pdf       binary
*.npz       binary
*.npy       binary
*.parquet   binary

# Generated reports: mark as generated for linguist
reports/figures/* linguist-generated=true
artifacts/sample-results/* linguist-generated=true
uv.lock linguist-generated=true
